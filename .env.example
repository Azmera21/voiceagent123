# Twilio credentials (required)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# OpenAI credentials (required for AI-driven patient simulation and analysis)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target test number (do not change unless authorized)
TARGET_PHONE_NUMBER=+18054398008

# Webhook server settings
WEBHOOK_BASE_URL=https://your-ngrok-or-server-url.com
WEBHOOK_PORT=5000

# Optional: override max call duration (seconds)
MAX_CALL_DURATION=300

# Optional: recordings output directory
RECORDINGS_DIR=recordings

# Optional: reports output directory
REPORTS_DIR=reports
